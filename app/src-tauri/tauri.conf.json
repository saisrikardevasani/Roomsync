{
  "$schema": "../node_modules/@tauri-apps/cli/schema.json",
  "build": {
    "beforeDevCommand":   "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devPath":            "http://localhost:1420",
    "distDir":            "../dist"
  },
  "package": {
    "productName": "RoomSync",
    "version":     "0.1.0"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "shell": { "all": false, "open": true }
    },
    "bundle": {
      "active":     true,
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ],
      "identifier":   "com.roomsync.app",
      "targets":      "all"
    },
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    },
    "windows": [
      {
        "fullscreen":  false,
        "height":      680,
        "resizable":   false,
        "title":       "RoomSync",
        "width":       420,
        "alwaysOnTop": true,
        "decorations": true
      }
    ],
    "systemTray": {
      "iconPath":        "icons/32x32.png",
      "iconAsTemplate":  true,
      "menuOnLeftClick": false
    }
  }
}
